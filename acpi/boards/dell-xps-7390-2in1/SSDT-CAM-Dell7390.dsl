/*
 * SSDT-CAM-Dell7390.dsl — Generated by acpi/scripts/gen_board_ssdt.py
 * Reusable UniCam ACPI contract (UNIC0001)
 *
 * Board ID  : dell,xps-7390-2in1
 * IPU       : ipu4p (\_SB.PCI0.IPU0)
 * Sensor    : OVTI01A0 (ovti,ov01a10) @ \_SB.PCI0.I2C3 addr 0x36
 * MIPI CSI2 : Port 6, 1 lane(s), MCLK 19200000 Hz (0xFDAD800C)
 */
DefinitionBlock ("", "SSDT", 2, "UNIC", "CAM7390 ", 0x00001000)
{
    External (\_SB_.PCI0.I2C3, DeviceObj)

    Scope (\_SB.PCI0.I2C3)
    {
        Device (UCAM)
        {
            Name (_HID, "UNIC0001")
            Name (_CID, "OVTI01A0")
            Name (_UID, 0x01)

            Method (_STA, 0, NotSerialized)
            {
                If (_OSI ("Darwin"))
                {
                    Return (0x0F)
                }
                Else
                {
                    Return (Zero)
                }
            }

            // Declare I2cSerialBusV2 under \_SB.PCI0.I2C3 so VoodooI2C attaches a VoodooI2CDeviceNub
            Name (_CRS, ResourceTemplate ()
            {
                I2cSerialBusV2 (0x0036, ControllerInitiated, 0x00061A80,
                    AddressingMode7Bit, "\\_SB.PCI0.I2C3",
                    0x00, ResourceConsumer, , Exclusive,
                    )
            })

            // Export configuration properties for AppleACPIPlatform -> IORegistry "device-properties"
            Method (_DSM, 4, Serialized)
            {
                // Ignore VoodooI2C TP7G UUID to prevent OSData cast errors in VoodooI2CDeviceNub::parseResourcesDSM()
                If ((Arg0 == ToUUID ("ef87eb82-f951-46da-84ec-14871ac6f84b")))
                {
                    Return (Buffer (One)
                    {
                        0x00
                    })
                }

                If ((Arg2 == Zero))
                {
                    Return (Buffer (One)
                    {
                        0x03
                    })
                }

                Return (Package ()
                {
                    "unicam-schema",         0x01,
                    "unicam-board-id",       "dell,xps-7390-2in1",
                    "unicam-ipu-gen",        "ipu4p",
                    "unicam-ipu-path",       "\\_SB.PCI0.IPU0",
                    "unicam-sensor-hid",     "OVTI01A0",
                    "unicam-sensor-compat",  "ovti,ov01a10",
                    "unicam-i2c-bus",        0x03,
                    "unicam-i2c-addr",       0x36,
                    "unicam-eeprom-addr",    0x50,
                    "unicam-csi-port",       0x06,
                    "unicam-csi-lanes",      0x01,
                    "unicam-link-freq-hz",   400000000,
                    "unicam-mclk-hz",        19200000,
                    "unicam-mclk-src",       0x01,
                    "unicam-mclk-reg",       0xFDAD800C,
                    "unicam-rotation",       0,
                    "unicam-position",       "front",
                    "unicam-gpio-mmio",      Package ()
                    {
                        Package (0x04) { 0x00, 0xFD6A06F0, 0x01, 10000 },
                        Package (0x04) { 0x0B, 0xFD6E0970, 0x01, 10000 },
                        Package (0x04) { 0x0C, 0xFD6D0740, 0x01, 5000 },
                        Package (0x04) { 0x0D, 0xFD6E08D0, 0x01, 0 },
                    },
                "unicam-gpio-reset-dw0",  0xFD6A06F0,
                "unicam-gpio-reset-act",  0x01,
                "unicam-gpio-pwdn-dw0",  0x00000000,
                "unicam-gpio-pwdn-act",  0x01,
                "unicam-gpio-power-dw0",  0xFD6E0970,
                "unicam-gpio-power-act",  0x01,
                "unicam-gpio-clken-dw0",  0xFD6D0740,
                "unicam-gpio-clken-act",  0x01,
                "unicam-gpio-led-dw0",  0xFD6E08D0,
                "unicam-gpio-led-act",  0x01,
                })
            }

            // Helper to write PCH GPIO Pad DW0 register (GPIO Mode, Output Enable, Set Tx State)
            Method (USET, 2, Serialized)
            {
                OperationRegion (GPAD, SystemMemory, Arg0, 0x04)
                Field (GPAD, DWordAcc, NoLock, Preserve)
                {
                    VAL0, 32
                }

                Local0 = VAL0
                Local0 &= 0xFFFFE2FE // Clear PMode (10..12), GPIOTxDis (8), GPIOTxState (0)
                If (Arg1)
                {
                    Local0 |= One
                }

                VAL0 = Local0
            }

            // PCH ICLK IMGCLKOUT_x register (0xFDAD800C)
            OperationRegion (CLKX, SystemMemory, 0xFDAD800C, 0x04)
            Field (CLKX, ByteAcc, NoLock, Preserve)
            {
                REGV, 8
            }

            // Helper to control PCH ICLK IMGCLKOUT_x register
            Method (UCLK, 1, Serialized)
            {
                Local0 = REGV
                Local0 &= 0xFC
                If (Arg0)
                {
                    Local0 |= 0x03
                }
                Else
                {
                    Local0 |= 0x01
                }

                REGV = Local0
            }

            // UCIN (): Return board capability bitmask
            Method (UCIN, 0, NotSerialized)
            {
                Return (0x07)
            }

            // UCPW (Arg0): 1 = Enable power + MCLK + release Reset; 0 = Assert Reset + stop MCLK + power off
            Method (UCPW, 1, Serialized)
            {
                If (Arg0)
                {
                USET (0xFD6A06F0, 0x00) // Hold RESET asserted before power-on: GPP_C_15
                // (No GPIO assigned: Hold PWDN asserted in shutdown before power-on)
                USET (0xFD6E0970, 0x01) // Enable POWER_ENABLE rail: GPP_A_21
                Sleep (0x0A) // Wait 10 ms for rail settling
                UCLK (One)   // Enable MCLK output
                USET (0xFD6D0740, 0x01) // Enable CLK_ENABLE gate: GPP_H_20
                Sleep (0x05) // Wait 5 ms for clock stabilization
                // (No GPIO assigned: Deassert PWDN to wake sensor)
                USET (0xFD6A06F0, 0x01) // Deassert RESET to start sensor: GPP_C_15
                Sleep (0x0A) // Wait 10 ms before starting I2C transactions
                }
                Else
                {
                USET (0xFD6E08D0, 0x00) // Ensure PRIVACY_LED is off: GPP_A_11
                USET (0xFD6A06F0, 0x00) // Assert RESET on sensor: GPP_C_15
                // (No GPIO assigned: Assert PWDN on sensor)
                Sleep (0x02) // Wait 2 ms
                USET (0xFD6D0740, 0x00) // Disable CLK_ENABLE gate: GPP_H_20
                UCLK (Zero)  // Disable MCLK output
                USET (0xFD6E0970, 0x00) // Disable POWER_ENABLE rail: GPP_A_21
                }

                Return (Zero)
            }

            // UCLD (Arg0): 1 = Turn on Privacy LED; 0 = Turn off Privacy LED
            Method (UCLD, 1, Serialized)
            {
                If (Arg0)
                {
                USET (0xFD6E08D0, 0x01) // Enable PRIVACY_LED: GPP_A_11
                }
                Else
                {
                USET (0xFD6E08D0, 0x00) // Disable PRIVACY_LED: GPP_A_11
                }

                Return (Zero)
            }

            // UCRS (): Pulse hardware Reset on the image sensor
            Method (UCRS, 0, Serialized)
            {
                USET (0xFD6A06F0, 0x00) // Assert RESET (Shutdown): GPP_C_15
            Sleep (0x05)
                USET (0xFD6A06F0, 0x01) // Deassert RESET (Active): GPP_C_15
            Sleep (0x0A)
                Return (Zero)
            }
        }
    }
}
